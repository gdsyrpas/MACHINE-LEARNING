likalg.fit(Xout, Y_train_outer)\n","  finalapot =telikalg.predict(Xoutsc)\n","  apotel5.append({'Best_k': otkk,'Best_Weight': otkw,'Accuracy':accuracy_score(Y_test_outer, finalapot),'Precision':precision_score(Y_test_outer, finalapot, average='weighted', zero_division=0\n","      ),\n","      'Recall': recall_score(Y_test_outer,finalapot,average='weighted',zero_division=0\n","      ),\n","      'F1-Score':f1_score(Y_test_outer,finalapot,average='weighted',zero_division=0\n","      ),\n","  })\n","nested_df = pd.DataFrame(apotel5)\n","print('ΑΠΟΤΕΛΕΣΜΑΤΑ NESTED CV')\n","display(nested_df)\n","print('\\nΜέσος όρος:')\n","print(nested_df[['Accuracy','Precision','Recall','F1-Score']].mean())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":286},"id":"Oc9L6f9JzTQx","executionInfo":{"status":"ok","timestamp":1793885722105,"user_tz":-120,"elapsed":15608,"user":{"displayName":"Γιωργος Συρπας","userId":"00672291760240651398"}},"outputId":"f96345ea-3a14-4e3b-960b-a07d9c2923db"},"execution_count":139,"outputs":[{"output_type":"stream","name":"stdout","text":["ΑΠΟΤΕΛΕΣΜΑΤΑ NESTED CV\n"]},{"output_type":"display_data","data":{"text/plain":["   Best_k Best_Weight  Accuracy  Precision    Recall  F1-Score\n","0      15     uniform  0.736768   0.746589  0.736768  0.731433\n","1      15    distance  0.737734   0.744585  0.737734  0.728006\n","2      15    distance  0.743382   0.748439  0.743382  0.737301"],"text/html":["\n","  <div id=\"df-ee7557a2-279c-46d6-bbbb-bd294ee4a9fb\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Best_k</th>\n","      <th>Best_Weig